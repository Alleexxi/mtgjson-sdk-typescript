{
  "name": "mtgjson-sdk",
  "version": "0.1.1",
  "description": "The official MTGJSON TypeScript SDK — a DuckDB-backed query client for MTGJSON card data",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --fix src/ tests/",
    "format": "biome format --write src/ tests/"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.4-r.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "mtg",
    "mtgjson",
    "magic-the-gathering",
    "duckdb",
    "sdk"
  ],
  "author": "Zachary Halpern <zach@mtgjson.com>",
  "license": "MIT"
}
